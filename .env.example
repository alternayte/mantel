# Copy to .env for local work. `just dev` reads it. Every value here matches docker-compose.yml.
MANTEL_PORT=8080
MANTEL_PUBLIC_BASE_URL=http://localhost:8080

MANTEL_DB_URL=jdbc:postgresql://localhost:5432/mantel
MANTEL_DB_USER=mantel
MANTEL_DB_PASSWORD=mantel

# The MinIO host ports. The container listens on 9000 whatever these say.
MANTEL_MINIO_PORT=9100
MANTEL_MINIO_CONSOLE_PORT=9101
MANTEL_S3_ENDPOINT=http://localhost:9100
MANTEL_S3_REGION=auto
MANTEL_S3_BUCKET=mantel
MANTEL_S3_ACCESS_KEY_ID=mantel
MANTEL_S3_SECRET_ACCESS_KEY=mantel-development
MANTEL_S3_FORCE_PATH_STYLE=true

# Sign-in mail. With no host the magic link is written to the log, which is what local work reads.
# MANTEL_SMTP_HOST=smtp.example.com
# MANTEL_SMTP_PORT=587
# MANTEL_SMTP_USERNAME=
# MANTEL_SMTP_PASSWORD=
# MANTEL_SMTP_FROM=mantel@example.com
# MANTEL_SMTP_STARTTLS=true

# GitHub sign-in. Without a client id the GitHub routes report that they are not configured.
# MANTEL_GITHUB_CLIENT_ID=
# MANTEL_GITHUB_CLIENT_SECRET=

# Storage a new account gets. One number, no tiers.
MANTEL_DEFAULT_QUOTA_BYTES=10737418240
